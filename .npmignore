# When publishing to npm, ship only the runtime + docs needed by consumers.
# The `files` field in package.json is the source of truth; this hardens it.

# dev / test
tools/
test/

# repo hygiene (not shipped in the package)
.github/
.gitignore
.gitattributes
.editorconfig
CHANGELOG.md
CONTRIBUTING.md

# runtime deps are resolved by the installer, not vendored
node_modules/
*.tgz
package-lock.json
